    {
      "direction": "app→host",
      "method": "result",
      "id": 1,
      "payload": {
        "tools": [
          {
            "annotations": {
              "readOnlyHint": false
            },
            "description": "Switch the invoice view to a named panel",
            "inputSchema": {
              "properties": {
                "panel": {
                  "enum": [
                    "summary",
                    "items"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "panel"
              ],
              "type": "object"
            },
            "name": "show_panel"
          },
          {
            "annotations": {
              "readOnlyHint": true
            },
            "description": "Draw the user's attention to one line item by index",
            "inputSchema": {
              "properties": {
                "index": {
                  "maximum": 3,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "index"
              ],
              "type": "object"
            },
            "name": "highlight_line_item"
          },
          {
            "annotations": {
              "readOnlyHint": false
            },
            "description": "Propose wording for the adjustment reason, for human review",
            "inputSchema": {
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            },
            "name": "propose_reason"
          },
          {
            "annotations": {
              "readOnlyHint": true
            },
            "description": "Read the view's current state",
            "inputSchema": {
              "type": "object"
            },
            "name": "get_state"
          }
        ]
      }
    },
    {
      "direction": "host→app",
      "method": "tools/call",
      "id": 2,
      "payload": {
        "arguments": {
          "panel": "items"
        },
        "name": "show_panel"
      }
    },
    {
      "direction": "app→host",
      "method": "result",
