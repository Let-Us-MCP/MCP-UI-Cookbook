{ "server": "apps/recipes/r06-image-annotator/server.js", "tool": "load_annotations",
  "arguments": {}, "host":{"hostCapabilities":{"serverTools":{},"downloadFile":{},"openLinks":{},"message":{"text":{}},"updateModelContext":{"text":{},"structuredContent":{}},"logging":{},"serverResources":{}},"hostContext":{"theme":"light","locale":"en-US","timeZone":"UTC","displayMode":"inline","availableDisplayModes":["inline","fullscreen"],"containerDimensions":{"maxHeight":620},"deviceCapabilities":{"hover":true,"touch":false}}},
  "steps": [
    { "label": "saved regions render",
      "expect": [ { "selector": ".box", "count": 2 },
                  { "selector": ".box span", "text": "scratch" },
                  { "selector": "#art rect", "minCount": 5 },
                  { "selector": "#art rect", "box": { "minWidth": 100, "minHeight": 60 } },
                  { "selector": "#undo", "attr": { "name": "disabled", "value": "" } } ] },
    { "label": "the keyboard draws a box without a pointer",
      "keysTarget": "#stage",
      "keys": ["Enter",
               "ArrowRight", "ArrowRight", "ArrowRight", "ArrowRight",
               "ArrowDown", "ArrowDown", "ArrowDown",
               "Enter"],
      "expect": [ { "selector": ".box", "count": 3 },
                  { "selector": "#undo", "noAttr": "disabled" } ] },
    { "label": "Escape abandons a box in progress",
      "keysTarget": "#stage",
      "keys": ["Enter", "ArrowRight", "ArrowRight", "Escape"],
      "expect": [ { "selector": ".box", "count": 3 },
                  { "selector": "#pending", "count": 0 },
                  { "selector": ".box span", "text": "scratch" } ] } ] }
