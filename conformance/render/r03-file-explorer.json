{ "server": "apps/recipes/r03-file-explorer/server.js", "tool": "list_files",
  "arguments": {}, "expectToolText": "Three top level entries", "host":{"hostCapabilities":{"serverTools":{},"downloadFile":{},"openLinks":{},"message":{"text":{}},"updateModelContext":{"text":{},"structuredContent":{}},"logging":{},"serverResources":{}},"hostContext":{"theme":"light","locale":"en-US","timeZone":"UTC","displayMode":"inline","availableDisplayModes":["inline","fullscreen"],"containerDimensions":{"maxHeight":620},"deviceCapabilities":{"hover":true,"touch":false}}},
  "steps": [
    { "label": "tree renders",
      "expect": [ { "selector": "#tree > li", "count": 3 },
                  { "selector": "[role=treeitem]", "minCount": 6 },
                  { "selector": "#detail p", "text": "Select something." } ] },
    { "label": "select a node", "click": "[role=treeitem]",
      "expect": [ { "selector": "#detail h2", "textContains": "documents" },
                  { "selector": "[aria-selected=\"true\"]", "count": 1 },
                  { "selector": "#rename", "attr": { "name": "disabled", "value": null } },
                  { "selector": ".preview", "count": 0 } ] },
    { "label": "selecting a text file previews it",
      "click": "[role=treeitem][data-id=\"notes\"]", "settleMs": 700,
      "expect": [ { "selector": ".preview", "count": 1 },
                  { "selector": ".preview-name", "text": "notes.txt" },
                  { "selector": ".preview-meta", "textContains": "text/plain" },
                  { "selector": ".preview-text", "textContains": "staging key" },
                  { "selector": ".preview", "attr": { "name": "class", "value": "preview md" } } ] },
    { "label": "the size control changes only the size",
      "click": ".preview-sizes button[data-size=\"sm\"]", "settleMs": 300,
      "expect": [ { "selector": ".preview", "attr": { "name": "class", "value": "preview sm" } },
                  { "selector": ".preview-text", "textContains": "staging key" },
                  { "selector": ".preview-sizes button[aria-pressed=\"true\"]", "count": 1 } ] },
    { "label": "an image previews as an image, not as bytes",
      "click": "[role=treeitem][data-id=\"cover\"]", "settleMs": 700,
      "expect": [ { "selector": ".preview-image", "count": 1 },
                  { "selector": ".preview-image", "attr": { "name": "alt", "value": "Preview of cover.png" } },
                  { "selector": ".preview-text", "count": 0 } ] },
    { "label": "a read that fails says so and keeps the tree",
      "failNextCall": { "isError": true,
        "content": [{ "type": "text", "text": "The workspace volume is offline." }] },
      "click": "[role=treeitem][data-id=\"q3\"]", "settleMs": 700,
      "expect": [ { "selector": "#preview-state", "textContains": "offline" },
                  { "selector": "#tree > li", "count": 3 } ] } ] }
