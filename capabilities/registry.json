{
  "protocol": {
    "core": "2026-07-28",
    "apps": "io.modelcontextprotocol/ui",
    "appsVersion": "2026-01-26",
    "sdk": "1.7.5"
  },
  "grounds": {
    "wire": "The MCP Apps extension defines a message for it.",
    "core": "Core MCP defines it; the view inherits it.",
    "platform": "The browser inside the sandbox provides it. No host round trip.",
    "app": "The view implements it. Nobody else can.",
    "gap": "No standard mechanism exists yet. The entry carries a workaround."
  },
  "levels": {
    "1": {
      "name": "Embedded",
      "summary": "Render, size, theme, link out, and know what you are running inside."
    },
    "2": {
      "name": "Interactive",
      "summary": "Focus, keyboard, selection, clipboard, files, dialogs, and errors that recover."
    },
    "3": {
      "name": "Native-Like",
      "summary": "Display modes, spatial interaction, lifecycle, persistence, history, media."
    },
    "4": {
      "name": "Agentic",
      "summary": "Tools, streaming, context, approval, and shared ownership of state."
    }
  },
